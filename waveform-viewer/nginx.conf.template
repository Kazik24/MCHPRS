server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://${WAVEFORM_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 30s;
        gzip off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
